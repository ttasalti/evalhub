# ==============================================================================
# scripts/configs/base.env
#
# Generic, MODEL- and BENCHMARK-AGNOSTIC config. Designed to be combined with
# CLI overrides at submit time:
#
#   scripts/submit.sh scripts/run_end_to_end.sh scripts/configs/base.env \
#       --model Qwen/Qwen3.5-0.8B-Base \
#       --judge Qwen/Qwen3.5-0.8B \
#       --benchmarks "aime2026 aime2026_tr aime2026_pt"
#
# Or for multi-model sweep via the DAG orchestrator:
#
#   scripts/orchestrate.sh scripts/configs/base.env sequential \
#       --models "A B" --benchmarks "x y" --judge Z
#
# If you set TARGET_MODEL / BENCHMARK / JUDGE_MODEL here, CLI overrides
# still win. Leave them blank to make CLI args mandatory.
# ==============================================================================

# --- Slurm allocation (consumed by scripts/submit.sh) -----------------------
SLURM_JOB_NAME="evalhub"
SLURM_GRES="gpu:nvidia_a100-pcie-40gb:1"
SLURM_CPUS_PER_TASK=8
SLURM_MEM="30G"
SLURM_TIME="12:00:00"
SLURM_NODELIST="nscluster"
# SLURM_PARTITION=""             # optional

# --- Run identity (override via CLI) ----------------------------------------
TARGET_MODEL=
JUDGE_MODEL=
BENCHMARK=
BENCHMARKS=
TARGET_STATE="base"
JUDGE_STATE="think"
OUTPUT_ROOT="results"

# --- Target (base) sampling defaults ----------------------------------------
TARGET_PARALLEL_COUNT=1
TARGET_TEMPERATURE=0.6
TARGET_N_SAMPLES=8
TARGET_TOP_P=0.95
TARGET_MAX_COMPLETION_TOKENS=16384
TARGET_FREQUENCY_PENALTY=0.0
TARGET_PRESENCE_PENALTY=0.0
TARGET_TIMEOUT=172800
TARGET_NUM_WORKERS=256
TARGET_PORT=30000

# --- Judge sampling defaults ------------------------------------------------
JUDGE_PARALLEL_COUNT=1
JUDGE_TEMPERATURE=0.6
JUDGE_N_SAMPLES=3
JUDGE_TOP_P=0.95
JUDGE_MAX_COMPLETION_TOKENS=16384
JUDGE_FREQUENCY_PENALTY=0.0
JUDGE_PRESENCE_PENALTY=0.0
JUDGE_TIMEOUT=172800
JUDGE_NUM_WORKERS=256
JUDGE_PORT=30001
JUDGE_TASK=cot_judge

# --- Optional vLLM runtime knobs (empty = vLLM defaults) --------------------
TARGET_GPU_MEMORY_UTILIZATION=
TARGET_MAX_MODEL_LEN=
TARGET_ENFORCE_EAGER=false
TARGET_SWAP_SPACE=
TARGET_DTYPE=
TARGET_KV_CACHE_DTYPE=
TARGET_VLLM_EXTRA_ARGS=
JUDGE_GPU_MEMORY_UTILIZATION=
JUDGE_MAX_MODEL_LEN=
JUDGE_ENFORCE_EAGER=false
JUDGE_SWAP_SPACE=
JUDGE_DTYPE=
JUDGE_KV_CACHE_DTYPE=
JUDGE_VLLM_EXTRA_ARGS=
