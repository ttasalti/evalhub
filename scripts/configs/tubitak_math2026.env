# EvalHub: TÜBİTAK Mathematics Olympiad 2026 (Pass@K + CoT-Pass@K)
#
# Submit with:
#   scripts/submit.sh scripts/run_end_to_end.sh scripts/configs/tubitak_math2026.env
#
# Override target/judge from CLI:
#   scripts/submit.sh scripts/run_end_to_end.sh scripts/configs/tubitak_math2026.env \
#       --model Qwen/Qwen3.5-0.8B-Base --judge Qwen/Qwen3.5-0.8B

# Slurm allocation
SLURM_JOB_NAME="evalhub-tubitak2026"
SLURM_GRES="gpu:nvidia_a100-pcie-40gb:1"
SLURM_CPUS_PER_TASK=8
SLURM_MEM="30G"
SLURM_TIME="12:00:00"
SLURM_NODELIST=""

TARGET_MODEL="Qwen/Qwen3.5-0.8B-Base"
JUDGE_MODEL="Qwen/Qwen3.5-0.8B"

BENCHMARK="tubitak_math2026"
OUTPUT_ROOT="results_tubitak2026"

TARGET_STATE="base"
JUDGE_STATE="think"

# Turkish judge prompt (the same one aime2026_tr uses). Required: the judge
# receives the Turkish problem text, so the English prompt would not match.
JUDGE_TASK="cot_judge_tr"

# Target sampling
TARGET_PARALLEL_COUNT=1
TARGET_TEMPERATURE=0.6
TARGET_N_SAMPLES=8
TARGET_TOP_P=0.95
TARGET_MAX_COMPLETION_TOKENS=16384
TARGET_TIMEOUT=172800
TARGET_PORT=30000

# Judge sampling
JUDGE_PARALLEL_COUNT=1
JUDGE_TEMPERATURE=0.6
JUDGE_N_SAMPLES=3
JUDGE_TOP_P=0.95
JUDGE_MAX_COMPLETION_TOKENS=16384
JUDGE_TIMEOUT=172800
JUDGE_PORT=30001
