# ============================================================================
# scripts/secrets.env.example
#
# Copy this file to scripts/secrets.env and fill in real values.
# scripts/secrets.env is gitignored — never commit real credentials.
#
# How it loads:
#   pipeline_common.sh:pipeline_load_env() checks two candidate paths after
#   sourcing the main env file:
#     1. <env_file_dir>/secrets.env      (next to the env file)
#     2. ${SCRIPT_DIR}/secrets.env       (fallback at scripts/secrets.env)
#   The first one found is sourced with `set -a` so its variables propagate
#   to every subprocess (vLLM, evalhub gen/eval, etc.).
# ============================================================================

# HuggingFace Hub access token. Used implicitly by `datasets.load_dataset()`
# for gated repos and to raise rate limits. Generate at:
#   https://huggingface.co/settings/tokens
# Required scopes: at least "read"; "read-and-write" if you want to push.
HF_TOKEN=""

# Optional — separate token for hf_transfer accelerated downloads (usually
# the same as HF_TOKEN). Uncomment if you use them separately.
# HF_HUB_TOKEN=""

# Optional — Weights & Biases API key, if you wire up wandb logging later.
# WANDB_API_KEY=""

# Optional — OpenAI API key, if you ever evaluate against a hosted model
# instead of a local vLLM endpoint.
# OPENAI_API_KEY=""
