# ============================================================================
# Shared env file for EvalHub orchestrators. Copy this to cot_pipeline.env
# (or any path of your choosing) and edit. Pass the file as $1 to any of
# scripts/run_*.sh, or export EVALHUB_PIPELINE_ENV.
#
# Variables are grouped by which scripts consume them. Anything left blank
# falls back to the default baked into scripts/lib/pipeline_common.sh.
# ============================================================================

# --- Required by ALL three scripts -----------------------------------------
BENCHMARK="aime2025"

# --- Required by run_eval_only.sh and run_end_to_end.sh --------------------
TARGET_MODEL="Qwen/Qwen3-7B-Instruct"

# --- Required by run_judge_only.sh and run_end_to_end.sh -------------------
JUDGE_MODEL="Qwen/Qwen3-32B-Instruct"

# --- Required ONLY by run_judge_only.sh ------------------------------------
# Either point to the parent directory of an existing base run, OR provide
# explicit file paths. Leave both unset when running run_end_to_end.sh.
# BASE_RESULTS_DIR="/path/to/results/<model_dir>/<benchmark>"
# BASE_RESULTS_FILE="${BASE_RESULTS_DIR}/<benchmark>_results.jsonl"
# BASE_RAW_FILE="${BASE_RESULTS_DIR}/<benchmark>_raw.jsonl"

# --- Model state per role: base | non-think | think ------------------------
TARGET_STATE="non-think"
JUDGE_STATE="think"

# --- Target sampling (run_eval_only.sh, run_end_to_end.sh) -----------------
TARGET_TEMPERATURE=0.6
TARGET_TOP_P=0.95
TARGET_N_SAMPLES=8
TARGET_MAX_COMPLETION_TOKENS=16384
TARGET_NUM_WORKERS=256
TARGET_TIMEOUT=3600
TARGET_FREQUENCY_PENALTY=0
TARGET_PRESENCE_PENALTY=0
TARGET_STOP=
TARGET_SYSTEM_PROMPT=
TARGET_OVERRIDE_ARGS=
TARGET_TOOL_CONFIG=
TARGET_CALLBACK=
TARGET_MAX_TURNS=3
TARGET_ENABLE_MULTITURN=false
TARGET_RESUME=false
TARGET_PARALLEL_COUNT=1

# --- Judge sampling (run_judge_only.sh, run_end_to_end.sh) -----------------
JUDGE_TASK="cot_judge"           # cot_judge | cot_judge_tr | cot_judge_pt
JUDGE_TEMPERATURE=0.6
JUDGE_TOP_P=0.95
JUDGE_N_SAMPLES=3
JUDGE_MAX_COMPLETION_TOKENS=16384
JUDGE_NUM_WORKERS=256
JUDGE_TIMEOUT=3600
JUDGE_FREQUENCY_PENALTY=0
JUDGE_PRESENCE_PENALTY=0
JUDGE_STOP=
JUDGE_SYSTEM_PROMPT=
JUDGE_TOOL_CONFIG=
JUDGE_CALLBACK=
JUDGE_MAX_TURNS=3
JUDGE_ENABLE_MULTITURN=false
JUDGE_RESUME=false
JUDGE_PARALLEL_COUNT=1

# --- Infra (all three scripts) ---------------------------------------------
OUTPUT_ROOT=
TARGET_PORT=30000
JUDGE_PORT=30001
HEALTH_TIMEOUT=1800
# LOG_DIR=                       # defaults to ${PROJECT_ROOT}/logs

# --- vLLM runtime knobs (optional, per role) -------------------------------
# Empty = use vLLM defaults. Set these only if you need to tune host RAM,
# GPU memory footprint, or generation behaviour for a specific run.
#
# TARGET_GPU_MEMORY_UTILIZATION=0.9   # vLLM default 0.9 (H200: ~127 GB)
# TARGET_MAX_MODEL_LEN=16384          # clamp model's max context (e.g. Qwen3.5: 262144)
# TARGET_ENFORCE_EAGER=true           # skip torch.compile (lower host RAM)
# TARGET_SWAP_SPACE=0                 # GB of CPU swap (0 disables)
# TARGET_DTYPE=                       # auto | bfloat16 | float16
# TARGET_KV_CACHE_DTYPE=              # auto | fp8
# TARGET_VLLM_EXTRA_ARGS=             # free-form passthrough,
#                                     #   e.g. "--disable-log-requests --quantization fp8"
# JUDGE_GPU_MEMORY_UTILIZATION=
# JUDGE_MAX_MODEL_LEN=
# JUDGE_ENFORCE_EAGER=true
# JUDGE_SWAP_SPACE=0
# JUDGE_DTYPE=
# JUDGE_KV_CACHE_DTYPE=
# JUDGE_VLLM_EXTRA_ARGS=

# --- Legacy aliases from the old vllm3.sh ----------------------------------
# These names are still accepted verbatim; when both the new and legacy name
# are set, the new name wins. Useful when migrating old env files unchanged.
#
#   MODEL                          -> TARGET_MODEL
#   TEMPERATURE                    -> TARGET_TEMPERATURE
#   N_SAMPLES                      -> TARGET_N_SAMPLES
#   MAX_COMPLETION_TOKENS          -> TARGET_MAX_COMPLETION_TOKENS
#   BASE_NUM_WORKERS               -> TARGET_NUM_WORKERS
#   BASE_TOP_P                     -> TARGET_TOP_P
#   BASE_FREQUENCY_PENALTY         -> TARGET_FREQUENCY_PENALTY
#   BASE_PRESENCE_PENALTY          -> TARGET_PRESENCE_PENALTY
#   BASE_TIMEOUT                   -> TARGET_TIMEOUT
#   BASE_STOP                      -> TARGET_STOP
#   BASE_SYSTEM_PROMPT             -> TARGET_SYSTEM_PROMPT
#   BASE_OVERRIDE_ARGS             -> TARGET_OVERRIDE_ARGS
#   BASE_TOOL_CONFIG               -> TARGET_TOOL_CONFIG
#   BASE_CALLBACK                  -> TARGET_CALLBACK
#   BASE_MAX_TURNS                 -> TARGET_MAX_TURNS
#   BASE_ENABLE_MULTITURN          -> TARGET_ENABLE_MULTITURN
#   BASE_RESUME                    -> TARGET_RESUME
#   BASE_MAX_COMPLETION_TOKENS     -> TARGET_MAX_COMPLETION_TOKENS
#   BASE_N_SAMPLES                 -> TARGET_N_SAMPLES
#   BASE_PARALLEL_COUNT            -> TARGET_PARALLEL_COUNT
#   PORT                           -> TARGET_PORT
#   JUDGE_TEMP                     -> JUDGE_TEMPERATURE
#   RESULTS_ROOT_DIR / RESULTS_BASE_DIR -> OUTPUT_ROOT
#   THINK_MODE=true|false          -> TARGET_STATE=think|non-think
#
# Soft defaults exported automatically (override here if you want):
#   PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
#   VLLM_USE_TRITON_FLASH_ATTN=0
#   VLLM_ENABLE_V1_MULTIPROCESSING=0   # in-process V1 engine; halves host RAM
#                                      # vs. vLLM 0.19's default fork mode.
