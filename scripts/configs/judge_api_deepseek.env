# ==============================================================================
# EvalHub — CoT judge over an EXISTING base run, via the DeepSeek API.
#
# Single judge generation (JUDGE_N_SAMPLES=1), no GPU: the judge model runs on
# DeepSeek's servers, so this can be submitted to a CPU node (drop --gres=gpu).
#
# The ONLY thing you provide at run time is the API key. Two ways, both keep the
# key OUT of git:
#   (a) export it before running:
#         export JUDGE_API_KEY=sk-...
#         scripts/run_judge_only.sh scripts/configs/judge_api_deepseek.env
#   (b) put it in the gitignored secrets file (sourced after this file, so it
#       wins) — set once, then just run:
#         echo 'JUDGE_API_KEY=sk-...' >> scripts/secrets.env
#         scripts/run_judge_only.sh scripts/configs/judge_api_deepseek.env
#
# Nothing here touches prompts / evaluation logic — only WHERE the judge runs.
# ==============================================================================

# --- external API judge backend ---------------------------------------------
JUDGE_BACKEND=api
JUDGE_API_BASE=https://api.deepseek.com/v1
JUDGE_API_KEY="${JUDGE_API_KEY:-}"          # from env / secrets.env; stays empty in git
JUDGE_MODEL=deepseek-chat                    # set to YOUR exact DeepSeek model id
                                             # (e.g. deepseek-chat / deepseek-reasoner / your V4 Flash id)

# --- single generation ------------------------------------------------------
JUDGE_N_SAMPLES=1
JUDGE_TEMPERATURE=0.6
JUDGE_TOP_P=0.95
JUDGE_MAX_COMPLETION_TOKENS=16384            # headroom for the judge's reasoning + \boxed{yes/no}
JUDGE_NUM_WORKERS=64                          # API concurrency; lower if you hit rate limits
JUDGE_TIMEOUT=3600
JUDGE_TASK=cot_judge                          # cot_judge (EN) | cot_judge_tr | cot_judge_pt
                                              # MUST match the benchmark language

# --- which EXISTING base run to judge (read-only) ---------------------------
# TARGET_MODEL is used only for naming/locating the judge output folder.
TARGET_MODEL=Qwen/Qwen3.5-0.8B-Base
BENCHMARK=aime2026
# Point straight at the base benchmark directory (contains <bench>_results.jsonl
# + <bench>_raw.jsonl). This is read-only; nothing is written here.
BASE_RESULTS_DIR=results/base/Qwen3.5-0.8B-Base/aime2026__t0.6__max16384__n4

# --- where the NEW judge output is written ----------------------------------
# A FRESH root so the existing results*/ trees are never written into.
# (results_api_judge/ is gitignored.)
OUTPUT_ROOT=results_api_judge
