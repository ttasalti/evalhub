# ==============================================================================
# EvalHub — Qwen3.5-0.8B demo run (per-config env file)
#
# Submit with:
#   scripts/submit.sh scripts/run_end_to_end.sh scripts/configs/qwen_0.8b_demo.env
#
# submit.sh reads the SLURM_* knobs below and forwards them as sbatch CLI
# overrides; the orchestrator script's #SBATCH header is used as a fallback
# when this file omits a knob.
# ==============================================================================

# --- Slurm allocation (used by scripts/submit.sh) ---------------------------
SLURM_JOB_NAME="evalhub-qwen-demo"
SLURM_GRES="gpu:nvidia_a100-pcie-40gb:1"
SLURM_CPUS_PER_TASK=8
SLURM_MEM="30G"
SLURM_TIME="12:00:00"
SLURM_NODELIST="nscluster"
# SLURM_PARTITION=""             # optional, override partition

TARGET_MODEL="Qwen/Qwen3.5-0.8B-Base"
JUDGE_MODEL="Qwen/Qwen3.5-0.8B"

BENCHMARKS="aime2026 aime2026_tr aime2026_pt"
OUTPUT_ROOT="results_demo"

TARGET_STATE="base"
JUDGE_STATE="think"

# ==============================================================================
# Target (base) sampling
# ==============================================================================
TARGET_PARALLEL_COUNT=1
TARGET_TEMPERATURE=0.6
TARGET_N_SAMPLES=4
TARGET_TOP_P=0.95
TARGET_MAX_COMPLETION_TOKENS=16384
TARGET_FREQUENCY_PENALTY=0.0
TARGET_PRESENCE_PENALTY=0.0
TARGET_TIMEOUT=172800

TARGET_STOP=
TARGET_SYSTEM_PROMPT=
TARGET_OVERRIDE_ARGS=
TARGET_ENABLE_MULTITURN=false
TARGET_MAX_TURNS=3
TARGET_TOOL_CONFIG=
TARGET_CALLBACK=
TARGET_RESUME=false

TARGET_PORT=30000

# ==============================================================================
# Target vLLM server runtime knobs (optional - empty = vLLM defaults)
# ==============================================================================
TARGET_GPU_MEMORY_UTILIZATION=
TARGET_MAX_MODEL_LEN=
TARGET_ENFORCE_EAGER=false
TARGET_SWAP_SPACE=
TARGET_DTYPE=
TARGET_KV_CACHE_DTYPE=
TARGET_VLLM_EXTRA_ARGS=

# ==============================================================================
# Judge sampling
# ==============================================================================
JUDGE_PARALLEL_COUNT=1
JUDGE_TEMPERATURE=0.6
JUDGE_N_SAMPLES=3
JUDGE_TOP_P=0.95
JUDGE_MAX_COMPLETION_TOKENS=16384
JUDGE_FREQUENCY_PENALTY=0.0
JUDGE_PRESENCE_PENALTY=0.0
JUDGE_TIMEOUT=172800

JUDGE_STOP=
JUDGE_SYSTEM_PROMPT=
JUDGE_ENABLE_MULTITURN=false
JUDGE_MAX_TURNS=3
JUDGE_TOOL_CONFIG=
JUDGE_CALLBACK=
JUDGE_RESUME=false

JUDGE_PORT=30001

# ==============================================================================
# Judge vLLM server runtime knobs (optional - empty = vLLM defaults)
# ==============================================================================
JUDGE_GPU_MEMORY_UTILIZATION=
JUDGE_MAX_MODEL_LEN=
JUDGE_ENFORCE_EAGER=false
JUDGE_SWAP_SPACE=
JUDGE_DTYPE=
JUDGE_KV_CACHE_DTYPE=
JUDGE_VLLM_EXTRA_ARGS=
